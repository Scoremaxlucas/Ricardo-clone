{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "chmod +x vercel-build.sh && ./vercel-build.sh",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "helvenda.ch"
        }
      ],
      "destination": "https://www.helvenda.ch/:path*",
      "permanent": true
    }
  ],
  "env": {
    "VERCEL_BYPASS_FALLBACK_OVERSIZED_ERROR": "1"
  },
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 60
    },
    "src/app/api/admin/ingest/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/orders/auto-release",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/dispute-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/auction-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/stripe-alerts",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/bexio-sync",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/process-account-deletions",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/payment-reminders",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/receipt-reminders",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/cleanup-id-documents",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/listing-auto-renew",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/credit-check-expiry",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/certificate-expiry-reminders",
      "schedule": "15 8 * * *"
    },
    {
      "path": "/api/cron/expire-certificates",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/check-listing-urls",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/rental-listing-expiry",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/wohnen-email-outbox",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/landlord-response-followup",
      "schedule": "30 9 * * *"
    }
  ]
}
