}

// ============================================
// MIETWOHNUNGEN (separat von Watch / Artikel)
// ============================================

enum RentalListingStatus {
  active
  rented
  archived
}

/**
 * Herkunft des Miet-Inserats (Akquisition / Admin / Partner).
 */
enum ImportSource {
  SELF // Admin oder Vermieter selbst erfasst
  IMPORTED // Import-Tool mit Erlaubnis (Original-URL in importedFrom)
  PARTNER // Partnerplattform (Kennzeichnung in importedFrom)
}

enum ExternalLandlordKind {
  private
  agency
  unknown
}

enum ExternalLandlordContactKind {
  email
  phone
  whatsapp
  other
}

enum ExternalLandlordPermissionKind {
  listing_publication
  photo_use
  text_use
  other
}

enum ExternalLandlordEvidenceSource {
  email
  whatsapp
  phone
  sms
  form
  manual
  import_url
  other
}

enum RentalApplicationStatus {
  pending_credit_check
  pending_manual_review
  approved
  rejected
}

/**
 * URL-Monitoring (Cron): letzter Prüfstatus des Original-Inserats.
 */
enum CheckStatus {
  UNCHECKED // noch nie geprüft
  ACTIVE // URL erreichbar, keine Vergeben-Hinweise
  GONE // 404/410
  RENTED // Text deutet auf vergeben hin
  UNREACHABLE // Timeout / Netzwerk
  MANUAL // keine gültige http(s)-URL zum Prüfen
}

/**
 * Automatische oder manuelle Deaktivierung (Admin-E-Mail / Übersicht).
 */
enum DeactivationReason {
  URL_404
  URL_RENTED
  STALE_REPORTS
  MANUAL_ADMIN
  /// Kalender-Gültigkeit (ohne überwachbare http(s)-Quell-URL) abgelaufen
  LISTING_EXPIRED
}

/**
 * Admin: E-Mail mit Link — externe Person reicht Inserat-URL ein; automatischer Import oder Entwurf.
 */
enum RentalListingInviteStatus {
  SENT
  URL_SUBMITTED
  LISTING_CREATED
  NEEDS_ADMIN
}

/**
 * Admin: Bulk-URL-Import — fehlgeschlagene / unvollständige Einträge zur manuellen Fertigstellung.
 */
enum RentalListingIngestDraftStatus {
  PENDING
  RESOLVED
  DISCARDED
}

model RentalListing {
  id                    String              @id @default(cuid())
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  userId                String
  externalLandlordId    String?
  title                 String
  description           String              @db.Text
  address               String
  zip                   String
  city                  String
  canton                String
  rooms                 Float
  areaSqm               Int
  floor                 Int?
  rentPerMonth          Int
  utilitiesPerMonth     Int?
  depositAmount         Int?
  availableFrom         DateTime
  photos                String // JSON string[] URLs, min 3 / max 10 in App
  requiresCreditCheck   Boolean             @default(true)
  status                RentalListingStatus @default(active)
  importedFrom          String? // Original-URL oder Partner-Kennzeichnung
  /**
   * Interne Referenz (z. B. Homegate) — Admin-only, kein Cron-Fetch.
   */
  referenceUrl          String?
  /**
   * Erlaubte Domains (Tutti, UrbanHome, …) — automatische Frische-Prüfung.
   */
  monitoringUrl         String?
  importSource          ImportSource        @default(SELF)
  landlordContact       String? // AES-GCM (Base64) oder Klartext-Präfix nur ohne Key — nur intern
  /**
   * Bewerbungs-Leads: E-Mail für Benachrichtigungen (optional; sonst Kontaktfeld / Inhaber-Konto).
   */
  landlordNotifyEmail   String?
  /**
   * Admin-Ingest: Erlaubnis-Basis (z. B. public_authority, landlord_direct, landlord_consent, tutti_public)
   */
  ingestPermissionBasis String?
  lastCheckedAt         DateTime?
  lastCheckStatus       CheckStatus         @default(UNCHECKED)
  staleReportCount      Int                 @default(0)
  staleReportedAt       DateTime?
  autoDeactivatedAt     DateTime?
  autoDeactivatedReason DeactivationReason?
  /// Aufeinanderfolgende UNREACHABLE-Läufe (Cron); bei ACTIVE/GONE/RENTED zurücksetzen.
  urlUnreachableStreak  Int                 @default(0)

  /// Inklusives Kalenderdatum (Europe/Zurich) YYYY-MM-DD; Pflicht wenn keine http(s)-`importedFrom`-URL.
  listingExpiresOn  String?
  /// Nach Ablauf: Admin soll verlängern oder endgültig entfernen / als erledigt markieren.
  needsExpiryReview Boolean @default(false)

  user                        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalLandlord            ExternalLandlord?            @relation(fields: [externalLandlordId], references: [id], onDelete: SetNull)
  applications                RentalApplication[]
  placements                  WohnenRentalPlacement[]
  listingMatchAlerts          WohnenListingMatchAlert[]
  sourceInvites               RentalListingInvite[]
  externalLandlordPermissions ExternalLandlordPermission[]
  externalLandlordAttachments ExternalLandlordAttachment[]

  @@index([userId])
  @@index([externalLandlordId])
  @@index([canton, status])
  @@index([rentPerMonth])
  @@index([availableFrom])
  @@index([importSource])
  @@index([status, lastCheckedAt])
  @@index([status, listingExpiresOn])
  @@map("rental_listings")
}

model RentalListingInvite {
  id              String                    @id @default(cuid())
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  token           String                    @unique
  email           String
  createdByUserId String
  createdBy       User                      @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  status          RentalListingInviteStatus @default(SENT)
  expiresAt       DateTime
  sentAt          DateTime                  @default(now())
  sourceUrl       String?
  urlSubmittedAt  DateTime?
  /// Rohdaten Ingest (JSON) + photos[] + warnings/errors — für Admin-Finalisierung bei NEEDS_ADMIN
  draftPayload    Json?
  lastError       String?                   @db.Text
  rentalListingId String?
  rentalListing   RentalListing?            @relation(fields: [rentalListingId], references: [id], onDelete: SetNull)

  @@index([createdByUserId])
  @@index([email])
  @@index([status])
  @@map("rental_listing_invites")
}

model RentalListingIngestDraft {
  id                String                         @id @default(cuid())
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  createdByUserId   String
  createdBy         User                           @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  sourceUrl         String                         @db.Text
  status            RentalListingIngestDraftStatus @default(PENDING)
  lastError         String?                        @db.Text
  /// Rohdaten Ingest (JSON) — gleiches Schema wie Bulk-API / Einladungs-Entwurf
  draftPayload      Json?
  resolvedListingId String?

  @@index([createdByUserId])
  @@index([status])
  @@map("rental_listing_ingest_drafts")
}

model ExternalLandlord {
  id                     String               @id @default(cuid())
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  displayName            String?
  kind                   ExternalLandlordKind @default(unknown)
  normalizedPrimaryEmail String?
  normalizedPrimaryPhone String?
  internalNotes          String?              @db.Text
  /**
   * Strukturierte Postanschrift für Briefversand (CRM).
   */
  postalStreet           String?
  postalZip              String?
  postalCity             String?
  postalCountry          String?              @default("CH")

  listings    RentalListing[]
  contacts    ExternalLandlordContact[]
  permissions ExternalLandlordPermission[]
  attachments ExternalLandlordAttachment[]

  @@index([displayName])
  @@index([normalizedPrimaryEmail])
  @@index([normalizedPrimaryPhone])
  @@map("external_landlords")
}

model ExternalLandlordContact {
  id                 String                      @id @default(cuid())
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  externalLandlordId String
  kind               ExternalLandlordContactKind
  label              String?
  valueEncrypted     String
  normalizedValue    String?
  isPrimary          Boolean                     @default(false)
  note               String?                     @db.Text

  externalLandlord ExternalLandlord @relation(fields: [externalLandlordId], references: [id], onDelete: Cascade)

  @@index([externalLandlordId])
  @@index([normalizedValue])
  @@map("external_landlord_contacts")
}

model ExternalLandlordPermission {
  id                 String                         @id @default(cuid())
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  externalLandlordId String
  rentalListingId    String?
  kind               ExternalLandlordPermissionKind
  source             ExternalLandlordEvidenceSource @default(manual)
  grantedAt          DateTime                       @default(now())
  summary            String                         @db.Text

  externalLandlord ExternalLandlord             @relation(fields: [externalLandlordId], references: [id], onDelete: Cascade)
  rentalListing    RentalListing?               @relation(fields: [rentalListingId], references: [id], onDelete: SetNull)
  attachments      ExternalLandlordAttachment[]

  @@index([externalLandlordId])
  @@index([rentalListingId])
  @@map("external_landlord_permissions")
}

model ExternalLandlordAttachment {
  id                 String                          @id @default(cuid())
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt
  externalLandlordId String
  rentalListingId    String?
  permissionId       String?
  source             ExternalLandlordEvidenceSource?
  label              String?
  fileName           String?
  mimeType           String?
  fileUrl            String
  note               String?                         @db.Text

  externalLandlord ExternalLandlord            @relation(fields: [externalLandlordId], references: [id], onDelete: Cascade)
  rentalListing    RentalListing?              @relation(fields: [rentalListingId], references: [id], onDelete: SetNull)
  permission       ExternalLandlordPermission? @relation(fields: [permissionId], references: [id], onDelete: SetNull)

  @@index([externalLandlordId])
  @@index([rentalListingId])
  @@index([permissionId])
  @@map("external_landlord_attachments")
}

model RentalApplication {
  id                           String                  @id @default(cuid())
  createdAt                    DateTime                @default(now())
  rentalListingId              String
  applicantUserId              String
  message                      String?                 @db.Text
  status                       RentalApplicationStatus
  encryptedFileRef             String? // Blob-URL o. Pfad zu verschlüsseltem PDF
  creditCheckResult            Json?
  viewingRequestedAt           DateTime?
  viewingDate                  DateTime?
  rejectedAt                   DateTime?
  rejectionNote                String?                 @db.Text
  tenantProfileId              String?
  tenantProfile                TenantProfile?          @relation(fields: [tenantProfileId], references: [id], onDelete: SetNull)
  staleReportedAt              DateTime?
  staleReportNote              String?                 @db.Text
  /**
   * E-Mail am Inserat / Auflösung — Zieladresse für den Vermieter (Audit).
   */
  landlordLeadEmail            String?
  /**
   * Tatsächliche Zustelladresse der Vermieter-Mail (kann Test-Override sein).
   */
  landlordLeadEmailDeliveredTo String?
  /**
   * Magic-Link-Token für Vermieter-Antwort ohne Konto (einmalig pro Bewerbung, rotierbar).
   */
  landlordLeadToken            String?                 @unique
  landlordLeadTokenExpiresAt   DateTime?
  landlordRespondedAt          DateTime?
  /**
   * Mieter über ausbleibende Vermieter-Rückmeldung informiert (Cron).
   */
  landlordNoResponseNotifiedAt DateTime?

  listing   RentalListing          @relation(fields: [rentalListingId], references: [id], onDelete: Cascade)
  applicant User                   @relation("RentalApplicationApplicant", fields: [applicantUserId], references: [id], onDelete: Cascade)
  placement WohnenRentalPlacement?

  @@unique([rentalListingId, applicantUserId])
  @@index([rentalListingId])
  @@index([applicantUserId])
  @@index([status])
  @@index([tenantProfileId])
  @@map("rental_applications")
}

enum WohnenCommissionStatus {
  pending
  invoiced
  paid
  waived
  cancelled
}

enum WohnenTenantBonusStatus {
  not_eligible
  eligible
  pending_payout
  paid
  excluded
}

/**
 * Erfolgreiche Vermittlung — Grundlage für Vermittlungsentgelt und Mieter-Einzugsbonus.
 */
model WohnenRentalPlacement {
  id                    String                  @id @default(cuid())
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  rentalApplicationId   String                  @unique
  rentalListingId       String
  applicantUserId       String
  netRentPerMonth       Int
  commissionPercent     Int                     @default(33)
  commissionAmountChf   Int
  vatRate               Float                   @default(0.081)
  vatAmountChf          Int
  commissionTotalChf    Int
  commissionStatus      WohnenCommissionStatus  @default(pending)
  moveInDate            DateTime?
  confirmedAt           DateTime?
  commissionInvoicedAt  DateTime?
  commissionPaidAt      DateTime?
  tenantBonusAmountChf  Int                     @default(250)
  tenantBonusStatus     WohnenTenantBonusStatus @default(eligible)
  tenantBonusEligibleAt DateTime?
  tenantBonusPaidAt     DateTime?
  adminNotes            String?                 @db.Text
  recordedByUserId      String?

  rentalApplication RentalApplication @relation(fields: [rentalApplicationId], references: [id], onDelete: Cascade)
  rentalListing     RentalListing     @relation(fields: [rentalListingId], references: [id], onDelete: Cascade)
  applicant         User              @relation("WohnenPlacementApplicant", fields: [applicantUserId], references: [id], onDelete: Cascade)
  recordedBy        User?             @relation("WohnenPlacementRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([rentalListingId])
  @@index([applicantUserId])
  @@index([commissionStatus])
  @@index([tenantBonusStatus])
  @@map("wohnen_rental_placements")
}

/**
 * Versendete «Neues Inserat passt zu deiner Suche»-Mails (Dedupe).
 */
model WohnenListingMatchAlert {
  id              String        @id @default(cuid())
  sentAt          DateTime      @default(now())
  tenantProfileId String
  rentalListingId String
  tenantProfile   TenantProfile @relation(fields: [tenantProfileId], references: [id], onDelete: Cascade)
  rentalListing   RentalListing @relation(fields: [rentalListingId], references: [id], onDelete: Cascade)

  @@unique([tenantProfileId, rentalListingId])
  @@index([rentalListingId])
  @@map("wohnen_listing_match_alerts")
}

/**
 * Wohnen: zuverlässiger E-Mail-Versand (Retry via Cron), z. B. Mieter-Bestätigung nach Bewerbung.
 */
enum WohnenEmailOutboxKind {
  TENANT_APPLICATION_CONFIRM
}

enum WohnenEmailOutboxStatus {
  pending
  sending
  sent
  failed
  cancelled
}

model WohnenEmailOutbox {
  id                  String                  @id @default(cuid())
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  kind                WohnenEmailOutboxKind
  dedupeKey           String                  @unique
  status              WohnenEmailOutboxStatus @default(pending)
  attempts            Int                     @default(0)
  nextAttemptAt       DateTime                @default(now())
  lastError           String?                 @db.Text
  sentAt              DateTime?
  payload             Json
  rentalApplicationId String?
  applicantUserId     String?

  @@index([status, nextAttemptAt])
  @@map("wohnen_email_outbox")
}

/// Admin-Aktionen (Compliance / Support) — keine sensiblen Inhalte, nur Metadaten.
model AdminAuditLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  adminUserId String
  action      String
  entityType  String
  entityId    String
  metadata    Json?

  @@index([entityType, entityId])
  @@index([adminUserId, createdAt])
  @@map("admin_audit_logs")
}

