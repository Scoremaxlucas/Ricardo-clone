  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName               String
  lastName                String
  dateOfBirth             DateTime
  currentAddress          String
  currentZip              String
  currentCity             String
  /**
   * Mietwohnung, Eigentum, Untermiete, Sonstiges — Selbstangabe im Mieterprofil.
   */
  currentHousingSituation CurrentHousingSituation?
  /**
   * Erster Tag des Monats «an dieser Adresse seit» (UTC).
   */
  currentHousingSince     DateTime?

  employmentStatus EmploymentStatus
  employer         String?
  jobTitle         String?
  employedSince    DateTime?

  monthlyIncomeCategory IncomeCategory

  /**
   * Anzahl Personen im Haushalt inkl. Bewerber/in (mind. 1).
   */
  householdTotalPersons  Int @default(1)
  /**
   * Anzahl im Haushalt lebender Kinder (0 wenn keine).
   */
  householdChildrenCount Int @default(0)

  /**
   * Erreichbarkeit für Vermieter (Pflicht im Mieterprofil).
   */
  contactPhone     String  @default("")
  /**
   * Optional: abweichende E-Mail für Bewerbungen; leer = Konto-E-Mail.
   */
  applicationEmail String?

  /**
   * Freiwillig: Nutzer bestätigt Nichtraucher(in) in der Wohnung (kein negatives Gegenfeld).
   */
  declaresNonSmoker Boolean?
  householdPets     HouseholdPets @default(NONE)

  referenceName     String?
  referencePhone    String?
  referenceRelation String?

  // Optionale Suchpräferenzen (Phase 1 Matching für Wohnen)
  preferredCanton         String?
  preferredPostalCodes    String?   @db.Text
  preferredBudgetMin      Int?
  preferredBudgetMax      Int?
  preferredMinRooms       Float?
  preferredMaxRooms       Float?
  preferredMoveInEarliest DateTime?
  preferredMoveInLatest   DateTime?

  creditCheckStatus                  CreditCheckStatus @default(NONE)
  creditCheckResult                  Json?
  encryptedFileRef                   String?
  creditCheckUploadedAt              DateTime?
  creditCheckExpiresAt               DateTime?
  /**
   * Letzte E-Mail „Betreibungsregisterauszug läuft ab“ (Cron, max. 1× / 24h Fenster)
   */
  expiryReminderSentAt               DateTime?
  /**
   * Einmalige E-Mail ca. 14 Tage vor Ablauf des Betreibungsregister-Auszugs
   */
  creditCheckExpiryReminder14dSentAt DateTime?

  isComplete Boolean @default(false)

  /**
   * IBAN für Auszahlung des Einzugsbonus (optional, manuelle Prüfung durch Admin).
   */
  bonusPayoutIban           String?
  /**
   * E-Mail-Benachrichtigung bei neuen passenden Inseraten (Cron).
   */
  listingMatchAlertsEnabled Boolean @default(true)

  applications       RentalApplication[]
  certificates       HelvendaCertificate[]
  listingMatchAlerts WohnenListingMatchAlert[]

  @@index([userId])
  @@map("tenant_profiles")
}

enum CertificateStatus {
  ACTIVE
  EXPIRED
  REVOKED
  SUPERSEDED
}

model HelvendaCertificate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantProfileId String
  tenantProfile   TenantProfile @relation(fields: [tenantProfileId], references: [id], onDelete: Cascade)

  certificateCode String @unique
  version         Int    @default(1)

  verifiedFirstName         String
  verifiedLastName          String
  verifiedAddress           String
  verifiedCity              String
  verifiedZip               String
  verifiedHousingSituation  CurrentHousingSituation?
  verifiedHousingSince      DateTime?
  verifiedEmploymentStatus  String
  verifiedEmployer          String?
  verifiedIncomeCategory    String
  verifiedCreditCheckStatus String
  verifiedCreditCheckDate   DateTime
  verifiedCreditCheckCanton String
  verifiedCreditEntryCount  Int
  incomeQualifiesUpTo       Int

  issuedAt  DateTime          @default(now())
  expiresAt DateTime
  status    CertificateStatus @default(ACTIVE)

  verificationCount Int       @default(0)
  lastVerifiedAt    DateTime?

  /**
   * Cron: einmalige Erinnerung ca. 14 Tage vor Zertifikats-Ablauf (ACTIVE)
   */
  expiryReminder14dSentAt DateTime?
  /**
   * Cron: einmalige Erinnerung in den letzten 3 Tagen vor Ablauf (ACTIVE)
   */
  expiryReminder3dSentAt  DateTime?

  @@index([certificateCode])
  @@index([userId])
  @@index([tenantProfileId])
  @@map("helvenda_certificates")
}

// ============================================
// HELVENDA MATCHING MVP (Phase 2 — getrennt von Miet-Inseraten)
// ============================================

enum LandlordMembershipRole {
  owner
  admin
  member
}

enum MatchPropertySource {
  manual
  csv
  api
}

enum MatchPropertyStatus {
  draft
  active
  paused
  archived
}

enum HousingMatchStatus {
  active
  stale
  hidden
  hard_rejected
}

enum MatchingApplicationStatus {
  draft
  submitted
  withdrawn
  landlord_reviewing
  landlord_accepted
  landlord_rejected
  closed
}

enum MatchingDocumentSubject {
  seeker_profile
  property
  matching_application
}

enum MatchingDocumentKind {
  id_proof
  income
  other
}

enum MatchingDocumentStatus {
  pending
  verified
  rejected
}

enum DocumentVerificationStatus {
  pending
  approved
  rejected
}

enum MatchingOutboxStatus {
  pending
  processing
  completed
  failed
}

model LandlordAccount {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  displayName String?

  memberships LandlordMembership[]
  properties  MatchingProperty[]

  @@map("matching_landlord_accounts")
}

model LandlordMembership {
  id                String                 @id @default(cuid())
  createdAt         DateTime               @default(now())
  landlordAccountId String
  userId            String
  role              LandlordMembershipRole @default(member)

  landlordAccount LandlordAccount @relation(fields: [landlordAccountId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([landlordAccountId, userId])
  @@index([userId])
  @@map("matching_landlord_memberships")
}

model MatchingProperty {
  id                String              @id @default(cuid())
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  landlordAccountId String
  source            MatchPropertySource @default(manual)
  title             String
  description       String?             @db.Text
  addressLine       String?
  zip               String
  city              String
  canton            String
  rooms             Decimal             @db.Decimal(4, 1)
  areaSqm           Int?
  floor             Int?
  rentPerMonth      Int
  availableFrom     DateTime?
  availableTo       DateTime?
  petPolicyNote     String?             @db.Text
  rulesJson         Json?
  status            MatchPropertyStatus @default(draft)

  landlordAccount LandlordAccount       @relation(fields: [landlordAccountId], references: [id], onDelete: Cascade)
  matches         HousingMatch[]
  applications    MatchingApplication[]

  @@index([landlordAccountId, status])
  @@index([canton, zip])
  @@index([status, rentPerMonth])
  @@map("matching_properties")
}

model SeekerProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String   @unique

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  searchProfile  SeekerSearchProfile?
  household      HouseholdProfile?
  employment     EmploymentProfile?
  financial      FinancialProfile?
  housingHistory HousingHistoryEntry[]
  matches        HousingMatch[]
  applications   MatchingApplication[]

  @@map("matching_seeker_profiles")
}

model SeekerSearchProfile {
  id                String    @id @default(cuid())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  seekerProfileId   String    @unique
  cantonPreference  String?
  postalCodesWanted String?   @db.Text
  budgetMin         Int?
  budgetMax         Int?
  minRooms          Decimal?  @db.Decimal(4, 1)
  maxRooms          Decimal?  @db.Decimal(4, 1)
  moveInEarliest    DateTime?
  moveInLatest      DateTime?

  seekerProfile SeekerProfile @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)

  @@index([cantonPreference])
  @@map("matching_seeker_search_profiles")
}

model HouseholdProfile {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  seekerProfileId String   @unique
  adults          Int      @default(1)
  children        Int      @default(0)
  petsDescription String?  @db.Text

  seekerProfile SeekerProfile @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)

  @@map("matching_household_profiles")
}

model EmploymentProfile {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  seekerProfileId  String   @unique
  employmentStatus String?
  employerName     String?

  seekerProfile SeekerProfile @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)

  @@map("matching_employment_profiles")
}

model FinancialProfile {
  id                   String   @id @default(cuid())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  seekerProfileId      String   @unique
  monthlyNetIncomeBand String?

  seekerProfile SeekerProfile @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)

  @@map("matching_financial_profiles")
}

model HousingHistoryEntry {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  seekerProfileId String
  fromDate        DateTime?
  toDate          DateTime?
  label           String?
  notes           String?   @db.Text

  seekerProfile SeekerProfile @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)

  @@index([seekerProfileId])
  @@map("matching_housing_history_entries")
}

model MatchingDocument {
  id               String                  @id @default(cuid())
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  subjectType      MatchingDocumentSubject
  subjectId        String
  uploadedByUserId String
  fileKey          String
  mimeType         String?
  kind             MatchingDocumentKind    @default(other)
  status           MatchingDocumentStatus  @default(pending)

  uploadedBy   User                  @relation("MatchingDocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  verification DocumentVerification?

  @@index([subjectType, subjectId])
  @@index([uploadedByUserId])
  @@map("matching_documents")
}

model DocumentVerification {
  id               String                     @id @default(cuid())
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  documentId       String                     @unique
  verifiedByUserId String?
  status           DocumentVerificationStatus @default(pending)
  notes            String?                    @db.Text
  verifiedAt       DateTime?

  document       MatchingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  verifiedByUser User?            @relation("DocumentVerificationVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("matching_document_verifications")
}

model HousingMatch {
  id              String             @id @default(cuid())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  seekerProfileId String
  propertyId      String
  score           Float              @default(0)
  hardFailed      Boolean            @default(false)
  status          HousingMatchStatus @default(active)
  computedAt      DateTime           @default(now())

  seekerProfile SeekerProfile        @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)
  property      MatchingProperty     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reasons       HousingMatchReason[]
  application   MatchingApplication?

  @@unique([seekerProfileId, propertyId])
  @@index([seekerProfileId, status, computedAt])
  @@index([propertyId, status, score])
  @@map("matching_matches")
}

model HousingMatchReason {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  matchId   String
  code      String
  detail    String?  @db.Text

  match HousingMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@map("matching_match_reasons")
}

model MatchingApplication {
  id              String                    @id @default(cuid())
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  propertyId      String
  seekerProfileId String
  housingMatchId  String?                   @unique
  status          MatchingApplicationStatus @default(draft)
  message         String?                   @db.Text

  property      MatchingProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  seekerProfile SeekerProfile    @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)
  housingMatch  HousingMatch?    @relation(fields: [housingMatchId], references: [id], onDelete: SetNull)
  consentShares ConsentShare[]

  @@index([propertyId, status])
  @@index([seekerProfileId, status])
  @@map("matching_applications")
}

model ConsentShare {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  applicationId String
  scope         String
  grantedAt     DateTime?
  revokedAt     DateTime?

  application MatchingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, scope])
  @@index([applicationId])
  @@map("matching_consent_shares")
}

model MatchingAuditLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?

  actorUser User? @relation("MatchingAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("matching_audit_logs")
}

model MatchingOutboxEvent {
  id          String               @id @default(cuid())
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  type        String
  payload     Json
  status      MatchingOutboxStatus @default(pending)
  processedAt DateTime?
  attempts    Int                  @default(0)
  lastError   String?              @db.Text

  @@index([status, createdAt])
  @@index([type])
  @@map("matching_outbox_events")
}

// ============================================
// Swiss Immo Cert (SIC) — modulares Mieter-Zertifikat
// E-Mail = Konto (Magic Link, kein Passwort). Nur bezahlte + freigegebene Module gelten als VERIFIZIERT.
// ============================================

enum SicCertificateStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum SicModuleKind {
  BONITAET
  ARBEIT_EINKOMMEN
  ZUVERLAESSIGKEIT
  AUFENTHALT
}

enum SicModuleStatus {
  PENDING_DOCS // bezahlt, Nachweise fehlen/unvollständig
  IN_REVIEW // Nachweise eingereicht, Prüfung offen
  VERIFIED // freigegeben -> erscheint als VERIFIZIERT
  REJECTED // abgelehnt
}

enum SicPaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

model SicCertificate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * E-Mail ist das Konto: gleiche Mail = gleiches Dossier. Immer kleingeschrieben gespeichert.
   */
  email           String @unique
  certificateCode String @unique

  holderFirstName String?
  holderLastName  String?

  status    SicCertificateStatus @default(ACTIVE)
  issuedAt  DateTime             @default(now())
  expiresAt DateTime

  verificationCount Int       @default(0)
  lastVerifiedAt    DateTime?

  expiryReminder14dSentAt DateTime?
  expiryReminder3dSentAt  DateTime?

  modules   SicCertificateModule[]
  documents SicDocument[]
  payments  SicPayment[]

  @@index([certificateCode])
  @@index([email])
  @@map("sic_certificates")
}

model SicCertificateModule {
  id            String         @id @default(cuid())
  certificateId String
  certificate   SicCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  moduleKind SicModuleKind
  status     SicModuleStatus @default(PENDING_DOCS)

  paidAt           DateTime  @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?
  reviewNote       String?   @db.Text
  /** Letzte Nudge-Mail «Nachweise fehlen» (PENDING_DOCS). */
  uploadReminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([certificateId, moduleKind])
  @@index([certificateId])
  @@map("sic_certificate_modules")
}

model SicDocument {
  id            String         @id @default(cuid())
  certificateId String
  certificate   SicCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  moduleKind  SicModuleKind
  blobUrl     String
  fileName    String
  contentType String
  sizeBytes   Int

  uploadedAt DateTime @default(now())

  @@index([certificateId])
  @@index([certificateId, moduleKind])
  @@map("sic_documents")
}

model SicPayment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * Vor der Zahlung existiert evtl. noch kein Zertifikat -> Verknüpfung per E-Mail.
   */
  email         String
  certificateId String?
  certificate   SicCertificate? @relation(fields: [certificateId], references: [id], onDelete: SetNull)

  /**
   * Optionaler, im Checkout eingegebener Name — belegt bei Neuerstellung den Zertifikatsnamen vor.
   */
  holderName String?

  stripeCheckoutSessionId String  @unique
  stripePaymentIntentId   String?

  includeBaseFee Boolean
  /**
   * Modul-IDs als Text (validiert in Code über normalizeSicModuleIds).
   */
  moduleKinds    String[]
  amountChf      Int
  currency       String           @default("CHF")
  status         SicPaymentStatus @default(PENDING)
  paidAt         DateTime?

  @@index([email])
  @@index([certificateId])
  @@map("sic_payments")
}

model SicMagicLink {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  email      String
  token      String    @unique
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([email])
  @@index([token])
  @@map("sic_magic_links")
}
