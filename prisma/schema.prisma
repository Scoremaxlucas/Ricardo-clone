model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String // Event name: 'click_listing', 'add_favorite', 'search', 'signup', 'purchase', etc.
  sessionId String // Anonymous session identifier
  userId    String? // Logged-in user ID (optional)
  path      String? // Page where event occurred
  metadata  String? // JSON string with event-specific data
  createdAt DateTime @default(now())

  @@index([name])
  @@index([sessionId])
  @@index([createdAt])
  @@index([name, createdAt])
  @@map("analytics_events")
}

// === MARKETING E-MAIL SYSTEM ===

model MarketingContact {
  id        String   @id @default(cuid())
  email     String   @unique
  tags      String   @default("[]") // JSON array: ["marketing", "newsletter"]
  source    String   @default("manual") // "manual", "registration", "contact-form"
  status    String   @default("active") // "active" | "unsubscribed"
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients MarketingRecipient[]

