# Database
DATABASE_URL="postgresql://username:password@localhost:5432/watchmarket?schema=public"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3002"
NEXTAUTH_SECRET="your-secret-key-here"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Google Cloud → Credentials → Authorized redirect URIs (beide):
#   https://www.helvenda.ch/api/auth/callback/google
#   https://swissimmocert.ch/api/auth/callback/google
# Authorized JavaScript origins: https://www.helvenda.ch und https://swissimmocert.ch
# AUTH_TRUST_HOST="true"

GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Stripe
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email (optional)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="noreply@watchmarket.com"

# File Upload
UPLOADTHING_SECRET="your-uploadthing-secret"
UPLOADTHING_APP_ID="your-uploadthing-app-id"

# Helvenda Matching — optional server-to-server JSON-Import (POST /api/matching/properties/import)
# MATCHING_IMPORT_API_SECRET="long-random-string"
# MATCHING_IMPORT_USER_ID="cuid-of-technical-user-who-owns-imported-properties"

# Helvenda Matching — Cron/Wartung: POST /api/internal/matching-maintenance (Header x-matching-maintenance-secret)
# MATCHING_MAINTENANCE_SECRET="long-random-string"

# Helvenda Wohnungen — Vercel Cron GET /api/cron/credit-check-expiry (Authorization: Bearer …)
# CRON_SECRET="openssl rand -hex 32"

# Einmalig alle Wohnen-Mailvorlagen an deine Adresse schicken (Resend oder SMTP nötig):
# npm run wohnen:templates-preview -- du@example.com

# Wohnen — Test: alle Vermieter-Lead-Mails an diese Adresse (statt an den echten Vermieter). Zum Deaktivieren entfernen.
# WOHNEN_LEAD_EMAIL_OVERRIDE="lucas.helvenda@outlook.com"

# Swiss Immo Cert — kanonische Site-URL (Apex). Cookies teilen Apex + www.
# NEXT_PUBLIC_SIC_URL="https://swissimmocert.ch"

# Swiss Immo Cert — Absender und Support.
# From muss @swissimmocert.ch sein (bei Resend verifizieren). Helvenda-From wird im Code abgelehnt.
# SIC_FROM_EMAIL="Swiss Immo Cert <hello@swissimmocert.ch>"
# SIC_SUPPORT_EMAIL="support@swissimmocert.ch"

# Swiss Immo Cert — Prüfung. Unabhängig von Helvenda-isAdmin. Komma-getrennt.
# Leer oder unset = niemand kommt ins SIC-Backoffice (fail-closed).
# SIC_ADMIN_EMAILS="pruefung@swissimmocert.ch"

# Swiss Immo Cert — Pflicht: Schlüssel für die Verschlüsselung hochgeladener Nachweise.
# Ohne diesen Schlüssel weist der Upload-Endpunkt Dateien ab (503), statt sie
# unverschlüsselt abzulegen. 64 Hex-Zeichen = 32 Bytes: openssl rand -hex 32
# Altbestand bleibt lesbar, solange RENTAL_PDF_ENCRYPTION_KEY gesetzt bleibt.
# SIC_DOC_ENCRYPTION_KEY="64-hex-chars"

# Swiss Immo Cert — privater Vercel-Blob-Store (empfohlen). Token aus dem privaten Store.
# SIC_BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# Nur Übergang: öffentlicher Ciphertext-Fallback erlauben (nicht dauerhaft):
# SIC_BLOB_ALLOW_PUBLIC_FALLBACK="true"
# BLOB_READ_WRITE_TOKEN="..."   # Fallback, wenn SIC_BLOB_* fehlt (Helvenda-Store)

# Swiss Immo Cert — Session-JWT (sonst NEXTAUTH_SECRET).
# SIC_SESSION_SECRET="long-random-string"

# Swiss Immo Cert — optional: Modell für die KI-Vorauswertung im Prüf-Backend.
# Ohne ANTHROPIC_API_KEY entfällt nur die Vorbefüllung; die Prüfung bleibt manuell möglich.
# SIC_DOCUMENT_PARSE_MODEL="claude-sonnet-4-5"

# Resend (SIC + Helvenda Mails)
# RESEND_API_KEY="re_..."

